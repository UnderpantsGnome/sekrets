#! /usr/bin/env ruby

require 'optparse'
require 'shellwords'

bindir = File.expand_path(File.dirname(__FILE__))
root = File.dirname(bindir)
libdir = File.join(root, 'lib')

require File.join(libdir, 'sekrets.rb')

trap('SIGINT') { STDERR.puts; exit!(42) }

module SekretsCLI
  module_function

  HELP = <<~TXT
    Usage: sekrets <command> [arguments] [options]

    Commands:
      write [output] [input]   Encrypt input to a file or stdout
      read [input] [output]    Decrypt input to a file or stdout
      edit <path>              Edit an encrypted file with $SEKRETS_EDITOR or $EDITOR
      recrypt <path>           Re-encrypt a file with a new key
      help                     Show this help

    Use `sekrets <command> --help` for command-specific help.
  TXT

  def run(argv = ARGV)
    argv = argv.dup
    command = argv.shift

    case command
    when nil, 'help', '-h', '--help'
      puts HELP
      0
    when 'write'
      run_write(argv)
    when 'read'
      run_read(argv)
    when 'edit'
      run_edit(argv)
    when 'recrypt'
      run_recrypt(argv)
    else
      warn "unknown command: #{command}"
      warn
      warn HELP
      1
    end
  rescue OptionParser::ParseError => error
    warn error.message
    1
  end

  def run_write(argv)
    options = {}
    parser = OptionParser.new do |opts|
      opts.banner = 'Usage: sekrets write [output] [input] [options]'
      opts.separator ''
      opts.separator 'Encrypt input and write the ciphertext to a file or stdout.'
      opts.on('-k', '--key KEY', 'Encryption key') { |value| options[:key] = value }
      opts.on('-h', '--help', 'Show help') { puts opts; exit 0 }
    end

    parser.parse!(argv)
    output = argv.shift || '-'
    input = argv.shift || '-'
    return usage_error(parser, argv) unless argv.empty?

    Sekrets.openw(output) do |output_io|
      key = Sekrets.key_for!(output, options)

      Sekrets.openr(input) do |input_io|
        output_io.write(Sekrets.encrypt(key, input_io.read))
      end
    end

    0
  end

  def run_read(argv)
    options = {}
    parser = OptionParser.new do |opts|
      opts.banner = 'Usage: sekrets read [input] [output] [options]'
      opts.separator ''
      opts.separator 'Decrypt input and write the plaintext to a file or stdout.'
      opts.on('-k', '--key KEY', 'Decryption key') { |value| options[:key] = value }
      opts.on('-h', '--help', 'Show help') { puts opts; exit 0 }
    end

    parser.parse!(argv)
    input = argv.shift || '-'
    output = argv.shift || '-'
    return usage_error(parser, argv) unless argv.empty?

    Sekrets.openr(input) do |input_io|
      key = Sekrets.key_for!(input, options)

      Sekrets.openw(output) do |output_io|
        output_io.write(Sekrets.decrypt(key, input_io.read))
      end
    end

    0
  end

  def run_recrypt(argv)
    options = { keys: [] }
    parser = OptionParser.new do |opts|
      opts.banner = 'Usage: sekrets recrypt <path> [-k OLD_KEY] [-k NEW_KEY]'
      opts.separator ''
      opts.separator 'Provide --key twice to avoid interactive prompts.'
      opts.on('-k', '--key KEY', 'Current key, then replacement key') { |value| options[:keys] << value }
      opts.on('-h', '--help', 'Show help') { puts opts; exit 0 }
    end

    parser.parse!(argv)
    path = argv.shift
    return missing_argument(parser, 'path') unless path
    return usage_error(parser, argv) unless argv.empty?

    current_key, new_key = options[:keys].first(2)
    current_key ||= Sekrets.ask("#{path} [cur key]")
    new_key ||= Sekrets.ask("#{path} [new key]")

    decrypted = Sekrets.read(path, :key => current_key)
    Sekrets.write(path, decrypted, :key => new_key)
    puts path
    0
  end

  def run_edit(argv)
    options = {}
    parser = OptionParser.new do |opts|
      opts.banner = 'Usage: sekrets edit <path> [options]'
      opts.separator ''
      opts.separator 'Edit an encrypted file using $SEKRETS_EDITOR, $EDITOR, or vim.'
      opts.on('-k', '--key KEY', 'Decryption key') { |value| options[:key] = value }
      opts.on('-h', '--help', 'Show help') { puts opts; exit 0 }
    end

    parser.parse!(argv)
    path = argv.shift
    return missing_argument(parser, 'path') unless path
    return usage_error(parser, argv) unless argv.empty?

    path = File.expand_path(path)
    key = Sekrets.key_for!(path, options)
    decrypted = test(?s, path) ? Sekrets.read(path, :key => key) : ''

    tmpfile = Sekrets.tmpfile_for(File.basename(path), decrypted)
    command = editor_command(tmpfile)
    status = Sekrets.system(command)

    if status.zero?
      Sekrets.write(path, IO.binread(tmpfile), :key => key)
      return 0
    end

    warn "command `#{command.shelljoin}` failed and no new `#{path}` was saved!"
    1
  end

  def editor_command(tmpfile)
    command = Shellwords.split(Sekrets.editor.to_s)
    command = ['vim'] if command.empty?
    command + [tmpfile]
  end

  def usage_error(parser, argv)
    warn "unexpected arguments: #{argv.join(' ')}"
    warn parser
    1
  end

  def missing_argument(parser, name)
    warn "missing argument: #{name}"
    warn parser
    1
  end
end

exit(SekretsCLI.run)
